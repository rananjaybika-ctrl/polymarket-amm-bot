[Unit]
Description=Polymarket Trading Bot - Web Dashboard
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/polymarket-amm-bot
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/ubuntu/polymarket-amm-bot/.env

# Start ONLY the web server - trading is started via web UI
# This ensures frontend stays up even when trading is stopped
ExecStart=/home/ubuntu/polymarket-amm-bot/venv/bin/uvicorn web.server:app --host 0.0.0.0 --port 8000

# ALWAYS restart web server - frontend should be always-on
Restart=always
RestartSec=5

StandardOutput=append:/home/ubuntu/polymarket-amm-bot/logs/server.log
StandardError=append:/home/ubuntu/polymarket-amm-bot/logs/server.log

# Resource limits
MemoryMax=1G
CPUQuota=50%

[Install]
WantedBy=multi-user.target
