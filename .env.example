# ============================================
# Polymarket AMM Bot - Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit your .env file to git!
# The .gitignore is already configured to exclude it.
# ============================================


# ============================================
# WALLET CONFIGURATION (REQUIRED)
# ============================================
# Your Polygon wallet private key
# Format: 64 hex characters, with or without 0x prefix
#
# WARNING: Keep this secret! Anyone with this key can access your funds.
WALLET_PRIVATE_KEY=your_64_character_hex_private_key_here
# Polygon RPC URL (optional - defaults to public endpoint)
# For better reliability, use a private RPC from Alchemy/Infura
# POLYGON_RPC_URL=https://polygon-rpc.com


# ============================================
# WALLET TYPE (IMPORTANT!)
# ============================================
# How did you log into Polymarket?
#
# WALLET_TYPE options:
#   "eoa"   - MetaMask, hardware wallet, or any standard wallet (default)
#   "magic" - Email login (Magic wallet) - REQUIRES FUNDER_ADDRESS below
#
WALLET_TYPE=eoa

# FUNDER_ADDRESS: Required ONLY for Magic/email wallets
# This is your actual Polymarket account address (not your signing key address)
# Find it: Log into polymarket.com → click your profile → copy the address
#
# Example: If you logged in via email, your Polymarket account might be
# 0x1404341D718bbd4e5683877fa57f1249016B8989 while your signing key
# derives to a different address. Set FUNDER_ADDRESS to your Polymarket address.
#
# FUNDER_ADDRESS=0xYourPolymarketAccountAddress


# ============================================
# POLYMARKET API (OPTIONAL)
# ============================================
# These have sensible defaults - only change if needed
# POLYMARKET_HOST=https://clob.polymarket.com
# CHAIN_ID=137


# ============================================
# TRADING PARAMETERS
# ============================================
# Capital limits (USD)
MAX_TOTAL_COST=20.0          # Maximum total exposure per market
MAX_TRADE_COST=10.0          # Maximum cost per single trade
MIN_TRADE_COST=0.5           # Minimum trade size (too small = not worth it)


# ============================================
# RISK PARAMETERS
# ============================================
# SAFETY_PAIR_COST: Emergency stop if pair cost exceeds this
# If pair_cost > 1.0, you're in loss territory
# Setting to 1.02 gives 2% buffer before emergency exit
SAFETY_PAIR_COST=1.02

# MAX_IMBALANCE: Maximum allowed position skew (0.0 to 1.0)
# 0.20 = max 20% difference between Up and Down shares
# Lower = safer but fewer fills; Higher = more fills but riskier
MAX_IMBALANCE=0.20

# MAX_POSITION_SHARES: Maximum shares per side (Up or Down)
MAX_POSITION_SHARES=50

# DAILY_LOSS_LIMIT: Pause bot if daily losses exceed this (USD)
DAILY_LOSS_LIMIT=20.0

# MAX_CONSECUTIVE_LOSSES: Auto-pause after this many losses in a row
MAX_CONSECUTIVE_LOSSES=3


# ============================================
# STRATEGY PARAMETERS
# ============================================
# GRID_LEVELS: Number of price levels (1 = simple strategy)
# Start with 1 until you understand the system
GRID_LEVELS=1

# GRID_SPACING: Price gap between grid levels (in dollars)
GRID_SPACING=0.01

# TARGET_LOCKED_PROFIT: Exit position when locked profit reaches this (USD)
TARGET_LOCKED_PROFIT=1.0

# ORDER_SIZE_PER_LEVEL: Shares per order
ORDER_SIZE_PER_LEVEL=10

# MIN_SPREAD: Minimum bid-ask spread to enter market
MIN_SPREAD=0.02


# ============================================
# TIMING PARAMETERS
# ============================================
# POLL_INTERVAL: Check for order fills every X seconds
POLL_INTERVAL=1.0

# REFRESH_GRID_SECONDS: Update grid orders every X seconds
REFRESH_GRID_SECONDS=5.0


# ============================================
# NETWORK CONFIGURATION (WIFI FAILOVER)
# ============================================
# Primary network name (your main WiFi)
PRIMARY_WIFI=YourMainWiFi

# Backup networks (will switch to these if primary fails)
BACKUP_WIFI_1=BackupNetwork1
BACKUP_WIFI_1_PASSWORD=backup1_password

BACKUP_WIFI_2=BackupNetwork2
BACKUP_WIFI_2_PASSWORD=backup2_password

# How often to check if primary is back (seconds)
NETWORK_POLL_INTERVAL=15


# ============================================
# DISCORD NOTIFICATIONS
# ============================================
# Create webhooks in your Discord server:
#   Right-click channel → Edit Channel → Integrations → Webhooks
#
# Channel purposes:
#   #pnl-summary - Trade completions, daily P&L (no @mention)
#   #losses      - Loss alerts (@mentions you)
#   #outages     - Network/API issues (@mentions you)

DISCORD_WEBHOOK_PNL=https://discord.com/api/webhooks/your_pnl_webhook
DISCORD_WEBHOOK_LOSSES=https://discord.com/api/webhooks/your_losses_webhook
DISCORD_WEBHOOK_OUTAGES=https://discord.com/api/webhooks/your_outages_webhook

# Your Discord User ID (for @mentions)
# Enable Developer Mode: User Settings → Advanced → Developer Mode
# Then right-click your username → Copy User ID
DISCORD_USER_ID=123456789012345678


# ============================================
# MODE FLAGS
# ============================================
# DRY_RUN_MODE: Simulate trades without real money
# ALWAYS start with this set to true!
DRY_RUN_MODE=true

# ENABLE_REAL_TRADING: Must be true to execute real trades
# Only set to true when you're confident the bot works
ENABLE_REAL_TRADING=false


# ============================================
# LOGGING
# ============================================
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# LOG_TO_FILE: Save logs to logs/ directory
LOG_TO_FILE=true
